---
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-700.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/golos-text/cyrillic-400.css';
import '@fontsource/golos-text/latin-400.css';
import '@fontsource/golos-text/cyrillic-500.css';
import '@fontsource/golos-text/latin-500.css';
import '@fontsource/golos-text/cyrillic-700.css';
import '@fontsource/golos-text/latin-700.css';
import '@fontsource/ibm-plex-mono/cyrillic-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/cyrillic-500.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/base.css';
import ReviewBar from '../components/ReviewBar.astro';

interface Props {
    title: string;
    description: string;
    /** Номер варианта лендинга. У обзорной страницы его нет. */
    version?: 1 | 2 | 3;
}

const { title, description, version } = Astro.props;
---

<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <!-- Варианты страницы сравниваются между собой и пока не предназначены для поисковиков. -->
        <meta name="robots" content="noindex" />
        <meta name="generator" content={Astro.generator} />
        <!--
            Шрифт и тема применяются до первой отрисовки, иначе страница мигнула бы
            оформлением по умолчанию. Значение из адреса (?font=golos&theme=dark) важнее
            сохранённого, так можно передать ссылку на конкретное сочетание.
        -->
        <script is:inline>
            (function () {
                try {
                    var root = document.documentElement;
                    var query = new URLSearchParams(location.search);
                    var font = query.get('font') || localStorage.getItem('weragen-site:font');
                    var theme = query.get('theme') || localStorage.getItem('weragen-site:theme');
                    if (font === 'golos' || font === 'plex') root.dataset.font = font;
                    if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
                } catch (error) {
                    // Хранилище недоступно в приватном режиме, остаётся оформление по умолчанию.
                }
            })();
        </script>
    </head>
    <body>
        <slot />
        <ReviewBar version={version} />
    </body>
</html>
