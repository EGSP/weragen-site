---
/**
 * Вариант 3, "Конспект".
 *
 * Страница состоит только из текста. Слева неподвижная колонка с названием, заголовком
 * и кнопками, справа короткие ответы на вопросы читателя. За образец лёгкости взят сайт
 * OpenTUI, но страница шире и рассказывает обо всём, что есть в других вариантах.
 */
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { typograph as t } from '../../lib/typograph';
import { site, digest } from '../../data/content';

// В узкой колонке заголовку разрешён перенос после "для": неразрывным остаётся только
// слово "ИИ-автоматизаций". Невидимый соединитель запрещает разрыв по дефису.
const heading = site.heading.replace('ИИ-', 'ИИ-⁠');
---

<Base title={site.title} description={site.description} version={3}>
    <div class="page container">
        <aside class="side">
            <a class="mark" href={withBase('/v3/')}>weragen</a>
            <div class="side__main">
                <h1>{heading}</h1>
                <p class="side__lead">{t(digest.lead)}</p>
                <div class="actions">
                    <a class="button button--solid" href={site.repository}>{site.primary}</a>
                    <a class="button button--outline" href="#contact">{site.secondary}</a>
                </div>
            </div>
        </aside>

        <main class="body">
            {
                digest.groups.map((group) => (
                    <section id={group.id}>
                        <h2>{t(group.title)}</h2>
                        {group.lines !== undefined && (
                            <ul>
                                {group.lines.map((line) => (
                                    <li>{t(line)}</li>
                                ))}
                            </ul>
                        )}
                        {group.text !== undefined && <p>{t(group.text)}</p>}
                    </section>
                ))
            }
            <footer class="foot" id="contact">
                <span>weragen, 2026</span>
                <span>{t(site.contactNote)}</span>
                <a href={site.repository}>GitHub</a>
            </footer>
        </main>
    </div>
</Base>

<style>
    .page {
        --container: 1240px;
        --radius: 10px;
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: 96px;
    }

    .mark {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.03em;
        text-decoration: none;
    }

    /* Колонка остаётся на месте, пока прокручивается текст справа. */
    .side {
        position: sticky;
        top: 0;
        align-self: start;
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 40px 0 140px;
    }

    .side__main {
        margin: auto 0;
    }

    /* Размер подобран так, чтобы слово "ИИ-автоматизаций" помещалось в ширину колонки. */
    h1 {
        font-size: min(48px, calc((100vw - 176px) * 0.043));
        line-height: 1.06;
        letter-spacing: -0.034em;
    }

    .side__lead {
        padding: 24px 0 32px;
        font-size: 19px;
        line-height: 1.5;
        color: var(--muted);
    }

    .body {
        padding-top: 132px;
    }

    .body section + section {
        padding-top: 88px;
    }

    h2 {
        font-size: 32px;
        line-height: 1.15;
        letter-spacing: -0.026em;
    }

    .body ul {
        display: grid;
        gap: 12px;
        padding-top: 24px;
        font-size: 22px;
        line-height: 1.35;
    }

    .body p {
        max-width: 32em;
        padding-top: 24px;
        font-size: 22px;
        line-height: 1.45;
    }

    .foot {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 32px;
        padding-top: 120px;
        font-size: 17px;
        color: var(--muted);
    }

    .foot a {
        margin-left: auto;
        color: var(--fg);
    }

    @media (max-width: 960px) {
        .page {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }

        .side {
            position: static;
            height: auto;
            padding: 32px 0 0;
        }

        .side__main {
            margin: 72px 0 0;
        }

        h1 {
            font-size: min(52px, calc((100vw - 2 * var(--gutter)) / 9.8));
        }

        .body {
            padding-top: 96px;
        }
    }

    @media (max-width: 560px) {
        .body section + section {
            padding-top: 64px;
        }

        h2 {
            font-size: 27px;
        }

        .body ul,
        .body p {
            font-size: 19px;
        }

        .foot a {
            margin-left: 0;
        }
    }
</style>
