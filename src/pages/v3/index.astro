---
/**
 * Версия 3, «Хаб».
 *
 * Страница строится вокруг схемы: платформа показана как центр, к которому подключаются
 * модули. Эта версия проверяет мысль о модульном устройстве weragen. Порядок разделов
 * взят с главной страницы JetBrains: сначала продукт целиком, затем колонки для разных
 * читателей, затем сравнение и путь одного запроса.
 */
import Base from '../../layouts/Base.astro';
import HubDiagram from '../../components/HubDiagram.astro';
import JournalMock from '../../components/JournalMock.astro';
import AliasMock from '../../components/AliasMock.astro';
import RegistryMock from '../../components/RegistryMock.astro';
import GraphMock from '../../components/GraphMock.astro';
import { withBase } from '../../lib/url';
import { typograph as t } from '../../lib/typograph';
import {
    site,
    hero,
    feature,
    modulesIntro,
    audiences,
    comparison,
    requestPath,
    nonGoals,
    status,
    openSource,
    cta,
} from '../../data/content';

const navigation = [
    { id: 'modules', label: 'Модули' },
    { id: 'audiences', label: 'Кому это нужно' },
    { id: 'comparison', label: 'Что меняется' },
    { id: 'scope', label: 'Границы' },
];

/**
 * Модули в сетке: широкие содержат схему, узкие обходятся текстом. У воркфлоу схема стоит
 * под текстом: граф читается слева направо, и в боковой колонке ему не хватило бы ширины.
 */
const modules = [
    { item: feature('models'), span: 4, visual: 'alias', stack: false },
    { item: feature('limits'), span: 2, visual: undefined, stack: false },
    { item: feature('agents'), span: 2, visual: undefined, stack: false },
    { item: feature('workflows'), span: 4, visual: 'graph', stack: true },
    { item: feature('hub'), span: 3, visual: 'registry', stack: false },
    { item: feature('journal'), span: 3, visual: 'journal', stack: false },
    { item: feature('api'), span: 6, visual: undefined, stack: false },
] as const;

const number = (index: number): string => String(index + 1).padStart(2, '0');
---

<Base title={site.title} description={site.description} version={3}>
    <div class="page">
        <header class="head">
            <div class="container head__inner">
                <a class="head__mark" href={withBase('/v3/')}>weragen</a>
                <nav class="head__nav" aria-label="Разделы страницы">
                    {navigation.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
                </nav>
                <a class="head__repo" href={site.repository}>GitHub</a>
            </div>
        </header>

        <main>
            <section class="hero container">
                <p class="eyebrow mono">{hero.status}</p>
                <h1>{t(hero.heading)}</h1>
                <p class="hero__lead">{t(hero.lead)}</p>
                <div class="actions hero__actions">
                    <a class="button button--solid" href={site.repository}>{hero.primary}</a>
                    <a class="button button--outline" href="#open">{hero.secondary}</a>
                </div>
                <div class="hero__diagram">
                    <HubDiagram />
                </div>
            </section>

            <section class="section container" id="modules">
                <div class="section-head">
                    <h2>{t(modulesIntro.title)}</h2>
                    <p>{t(modulesIntro.text)}</p>
                </div>
                <ul class="bento">
                    {
                        modules.map((module, index) => (
                            <li
                                class:list={[
                                    'bento__item',
                                    `bento__item--${module.span}`,
                                    { 'bento__item--stack': module.stack },
                                ]}
                            >
                                <div class="bento__text">
                                    <p class="bento__index mono">
                                        модуль {number(index)}. {module.item.label}
                                    </p>
                                    <h3>{t(module.item.title)}</h3>
                                    <p>{t(module.item.text)}</p>
                                </div>
                                {module.visual !== undefined && (
                                    <div class="bento__visual">
                                        <p class="bento__caption mono">схема интерфейса</p>
                                        {module.visual === 'alias' && <AliasMock />}
                                        {module.visual === 'graph' && <GraphMock />}
                                        {module.visual === 'registry' && <RegistryMock />}
                                        {module.visual === 'journal' && <JournalMock />}
                                    </div>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container" id="audiences">
                <div class="section-head">
                    <h2>{t('Кому это нужно')}</h2>
                    <p>
                        {
                            t(
                                'Платформой пользуются разработчики, а решение о ней принимает ' +
                                    'организация. У каждого свои вопросы.',
                            )
                        }
                    </p>
                </div>
                <ul class="audiences">
                    {
                        audiences.map((audience) => (
                            <li>
                                <h3>{t(audience.title)}</h3>
                                <p class="audiences__lead">{t(audience.lead)}</p>
                                <ul>
                                    {audience.points.map((point) => <li>{t(point)}</li>)}
                                </ul>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container" id="comparison">
                <div class="section-head">
                    <h2>{t(comparison.title)}</h2>
                </div>
                <div class="compare" role="table">
                    <div class="compare__row compare__row--head mono" role="row">
                        <span role="columnheader">{comparison.before}</span>
                        <span role="columnheader">{comparison.after}</span>
                    </div>
                    {
                        comparison.rows.map((row) => (
                            <div class="compare__row" role="row">
                                <p class="compare__before" role="cell">
                                    {t(row.before)}
                                </p>
                                <p class="compare__after" role="cell">
                                    {t(row.after)}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <section class="section container" id="path">
                <div class="section-head">
                    <h2>{t(requestPath.title)}</h2>
                </div>
                <ol class="path">
                    {
                        requestPath.steps.map((step, index) => (
                            <li>
                                <span class="path__mark mono">{index + 1}</span>
                                <h3>{t(step.title)}</h3>
                                <p>{t(step.text)}</p>
                            </li>
                        ))
                    }
                </ol>
            </section>

            <section class="section container" id="scope">
                <div class="section-head">
                    <h2>{t(nonGoals.title)}</h2>
                    <p>{t(nonGoals.intro)}</p>
                </div>
                <dl class="defs">
                    {
                        nonGoals.items.map((item) => (
                            <div>
                                <dt>{t(item.title)}</dt>
                                <dd>{t(item.text)}</dd>
                            </div>
                        ))
                    }
                </dl>
            </section>

            <section class="section container" id="status">
                <div class="section-head">
                    <h2>{t(status.title)}</h2>
                    <p>{t(status.intro)}</p>
                </div>
                <div class="status">
                    {
                        [status.first, status.later].map((group) => (
                            <div>
                                <h3 class="mono">{group.title}</h3>
                                <ul>
                                    {group.items.map((item) => <li>{t(item)}</li>)}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </section>

            <section class="closing container" id="open">
                <h2>{t(openSource.title)}</h2>
                {openSource.paragraphs.map((paragraph) => <p>{t(paragraph)}</p>)}
                <div class="actions closing__actions">
                    <a class="button button--solid" href={site.repository}>{hero.primary}</a>
                </div>
                <p class="closing__note mono">{t(cta.contactNote)}</p>
            </section>
        </main>

        <footer class="foot">
            <div class="container foot__inner">
                <span class="head__mark">weragen</span>
                <span class="foot__text">{t(hero.heading)}, 2026</span>
                <a href={site.repository}>GitHub</a>
            </div>
        </footer>
    </div>
</Base>

<style>
    .page {
        --container: 1200px;
        --radius: 10px;
    }

    .eyebrow {
        font-size: 13px;
        color: var(--muted);
    }

    .head {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
    }

    .head__inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        height: 60px;
        font-size: 15px;
    }

    .head__mark {
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.025em;
        text-decoration: none;
    }

    .head__nav {
        display: flex;
        gap: 28px;
    }

    .head__nav a {
        text-decoration: none;
        color: var(--muted);
    }

    .head__nav a:hover {
        color: var(--fg);
    }

    .head__repo {
        justify-self: end;
    }

    .hero {
        padding: 96px 0 32px;
        text-align: center;
    }

    h1 {
        max-width: 20ch;
        margin-inline: auto;
        padding-top: 20px;
        font-size: min(68px, var(--title-fit));
        line-height: 1.04;
        letter-spacing: -0.032em;
    }

    .hero__lead {
        max-width: 68ch;
        margin-inline: auto;
        padding: 26px 0 34px;
        font-size: 18px;
        line-height: 1.62;
        color: var(--muted);
    }

    .hero__actions {
        justify-content: center;
    }

    .hero__diagram {
        padding-top: 80px;
        text-align: left;
    }

    .section {
        padding-top: 128px;
    }

    .section-head {
        max-width: 760px;
        padding-bottom: 44px;
    }

    h2 {
        font-size: clamp(28px, 3.4vw, 44px);
        line-height: 1.1;
        letter-spacing: -0.022em;
    }

    .section-head p {
        padding-top: 16px;
        font-size: 18px;
        line-height: 1.62;
        color: var(--muted);
    }

    .bento {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 16px;
    }

    .bento__item {
        display: grid;
        align-content: start;
        gap: 24px;
        min-width: 0;
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }

    .bento__item--2 {
        grid-column: span 2;
    }

    .bento__item--3 {
        grid-column: span 3;
    }

    .bento__item--4 {
        grid-column: span 4;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 32px;
    }

    .bento__item--4.bento__item--stack {
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
    }

    .bento__item--6 {
        grid-column: span 6;
    }

    .bento__item--6 .bento__text {
        max-width: 760px;
    }

    .bento__index {
        padding-bottom: 14px;
        font-size: 12px;
        color: var(--muted);
    }

    .bento h3 {
        padding-bottom: 10px;
        font-size: 21px;
        line-height: 1.22;
        letter-spacing: -0.012em;
    }

    .bento__text > p:last-child {
        font-size: 15px;
        line-height: 1.62;
        color: var(--muted);
    }

    .bento__visual {
        min-width: 0;
        padding: 16px;
        background: var(--surface);
        border-radius: calc(var(--radius) - 4px);
    }

    .bento__caption {
        padding-bottom: 12px;
        font-size: 11px;
        color: var(--muted);
    }

    .audiences {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--fg);
    }

    .audiences > li {
        padding: 32px 32px 8px 0;
    }

    .audiences > li + li {
        padding-left: 32px;
        border-left: 1px solid var(--line);
    }

    .audiences h3 {
        font-size: 24px;
        line-height: 1.2;
        letter-spacing: -0.015em;
    }

    .audiences__lead {
        padding: 10px 0 22px;
        font-size: 16px;
        color: var(--muted);
    }

    .audiences li li {
        padding: 12px 0;
        border-top: 1px solid var(--line);
        font-size: 15px;
        line-height: 1.5;
    }

    .compare__row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 48px;
        padding: 20px 0;
        border-top: 1px solid var(--line);
        font-size: 16.5px;
        line-height: 1.5;
    }

    .compare__row--head {
        padding: 0 0 14px;
        border-top: 0;
        font-size: 12px;
        color: var(--muted);
    }

    .compare__row:nth-child(2) {
        border-top-color: var(--fg);
    }

    .compare__before {
        color: var(--muted);
    }

    .compare__after {
        font-weight: 500;
    }

    .path {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .path li {
        position: relative;
        padding: 52px 24px 0 0;
    }

    /* Линия пути проходит через отметки шагов и обрывается на последней. */
    .path li::before {
        content: '';
        position: absolute;
        top: 16px;
        left: 0;
        right: 0;
        border-top: 1px solid var(--fg);
    }

    .path li:last-child::before {
        right: auto;
        width: 16px;
    }

    .path__mark {
        position: absolute;
        top: 0;
        left: 0;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        background: var(--bg);
        border: 1px solid var(--fg);
        border-radius: 50%;
        font-size: 13px;
    }

    .path h3 {
        padding-bottom: 8px;
        font-size: 17px;
        line-height: 1.3;
    }

    .path p {
        font-size: 14.5px;
        line-height: 1.58;
        color: var(--muted);
    }

    .defs > div {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 8px 48px;
        padding: 18px 0;
        border-top: 1px solid var(--line);
    }

    .defs > div:first-child {
        border-top-color: var(--fg);
    }

    .defs dt {
        font-size: 17px;
        font-weight: 600;
    }

    .defs dd {
        font-size: 16px;
        color: var(--muted);
    }

    .status {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 48px;
    }

    .status h3 {
        padding-bottom: 12px;
        font-size: 13px;
        font-weight: 500;
    }

    .status li {
        padding: 12px 0;
        border-top: 1px solid var(--line);
        font-size: 16px;
    }

    .status div:first-child li:first-child,
    .status div:last-child li:first-child {
        border-top-color: var(--fg);
    }

    .closing {
        display: grid;
        justify-items: center;
        margin-top: 128px;
        padding: 88px 0 24px;
        border-top: 1px solid var(--fg);
        text-align: center;
    }

    .closing > p:not(.closing__note) {
        max-width: 62ch;
        padding-top: 16px;
        font-size: 18px;
        line-height: 1.62;
        color: var(--muted);
    }

    .closing__actions {
        padding-top: 32px;
    }

    .closing__note {
        padding-top: 16px;
        font-size: 12px;
        color: var(--muted);
    }

    .foot {
        margin-top: 64px;
        border-top: 1px solid var(--line);
    }

    .foot__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px 24px;
        padding: 24px 0;
        font-size: 14px;
    }

    .foot__text {
        margin-right: auto;
        color: var(--muted);
    }

    @media (max-width: 1000px) {
        .bento__item--2,
        .bento__item--3 {
            grid-column: span 3;
        }

        .bento__item--4 {
            grid-column: span 6;
        }

        .bento__item:nth-child(2),
        .bento__item:nth-child(3) {
            grid-column: span 3;
        }

        .path {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }

        .path li {
            padding: 4px 0 28px 52px;
        }

        .path li::before {
            top: 0;
            bottom: 0;
            left: 16px;
            right: auto;
            border-top: 0;
            border-left: 1px solid var(--fg);
        }

        .path li:last-child::before {
            bottom: auto;
            width: 0;
            height: 16px;
        }

        .audiences {
            grid-template-columns: minmax(0, 1fr);
        }

        .audiences > li,
        .audiences > li + li {
            padding: 28px 0 8px;
            border-left: 0;
        }

        .audiences > li + li {
            border-top: 1px solid var(--fg);
        }
    }

    @media (max-width: 760px) {
        .head__inner {
            grid-template-columns: 1fr auto;
        }

        .head__nav {
            display: none;
        }

        .hero {
            padding-top: 56px;
        }

        .hero__diagram {
            padding-top: 56px;
        }

        .section {
            padding-top: 88px;
        }

        .bento__item,
        .bento__item--2,
        .bento__item--3,
        .bento__item--4,
        .bento__item:nth-child(2),
        .bento__item:nth-child(3) {
            grid-column: span 6;
            grid-template-columns: minmax(0, 1fr);
            padding: 22px;
        }

        .compare__row {
            grid-template-columns: minmax(0, 1fr);
            gap: 8px;
        }

        .compare__row--head {
            display: none;
        }

        .defs > div,
        .status {
            grid-template-columns: minmax(0, 1fr);
        }

        .status {
            gap: 36px;
        }

        .closing {
            margin-top: 88px;
            padding-top: 64px;
        }
    }
</style>
