---
/**
 * Вариант 1, "Сборная".
 *
 * Страница продукта, собранная из блоков, которые автор проекта отметил в первом наборе:
 * полоса фактов под заголовком, блок о нагрузке и квотах, схема контура организации,
 * блок об управлении на перевёрнутом фоне, карточки "чем не является" и подвал с колонками.
 * Мелких подписей, нумерации и схем интерфейса здесь нет.
 */
import Base from '../../layouts/Base.astro';
import HubDiagram from '../../components/HubDiagram.astro';
import { withBase } from '../../lib/url';
import { typograph as t } from '../../lib/typograph';
import { site, combined, nonGoals } from '../../data/content';

const navigation = [
    { id: 'features', label: 'Возможности' },
    { id: 'perimeter', label: 'Контур' },
    { id: 'control', label: 'Управление' },
    { id: 'scope', label: 'Границы' },
];
---

<Base title={site.title} description={site.description} version={1}>
    <div class="page">
        <header class="head">
            <div class="container head__inner">
                <a class="mark" href={withBase('/v1/')}>weragen</a>
                <nav class="head__nav" aria-label="Разделы страницы">
                    {navigation.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
                </nav>
                <a class="button button--solid head__button" href={site.repository}>GitHub</a>
            </div>
        </header>

        <main>
            <section class="hero container">
                <h1>{site.headingStart} <span class="keep">{site.headingEnd}</span></h1>
                <p class="hero__lead">{t(combined.lead)}</p>
                <div class="actions">
                    <a class="button button--solid" href={site.repository}>{site.primary}</a>
                    <a class="button button--outline" href="#contact">{site.secondary}</a>
                </div>
                <ul class="highlights">
                    {
                        combined.highlights.map((item) => (
                            <li>
                                <strong>{t(item.title)}</strong>
                                <span>{t(item.text)}</span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container" id="features">
                <h2>{t(combined.features.title)}</h2>
                <ul class="features">
                    {
                        combined.features.items.map((item) => (
                            <li>
                                <h3>{t(item.title)}</h3>
                                <p>{t(item.text)}</p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container" id="load">
                <div class="panel">
                    <h2>{t(combined.load.title)}</h2>
                    <div>
                        <p>{t(combined.load.text)}</p>
                        <ul>
                            {combined.load.points.map((point) => <li>{t(point)}</li>)}
                        </ul>
                    </div>
                </div>
            </section>

            <section class="section container" id="perimeter">
                <h2>{t(combined.perimeter.title)}</h2>
                <p class="lead">{t(combined.perimeter.text)}</p>
                <div class="figure">
                    <HubDiagram />
                </div>
            </section>

            <section class="invert" id="control">
                <div class="container invert__grid">
                    <div>
                        <h2>{t(combined.control.title)}</h2>
                        <p class="lead">{t(combined.control.text)}</p>
                    </div>
                    <dl class="answers">
                        {
                            combined.control.items.map((item) => (
                                <div>
                                    <dt>{t(item.title)}</dt>
                                    <dd>{t(item.text)}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>
            </section>

            <section class="section container" id="scope">
                <h2>{t(combined.scopeTitle)}</h2>
                <ul class="cards">
                    {
                        nonGoals.map((item) => (
                            <li>
                                <h3>{item.title}</h3>
                                <p>{t(item.text)}</p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container closing" id="open">
                <h2>{t(combined.open.title)}</h2>
                <p class="lead">{t(combined.open.text)}</p>
                <div class="actions">
                    <a class="button button--solid" href={site.repository}>{site.primary}</a>
                    <a class="button button--outline" href="#contact">{site.secondary}</a>
                </div>
            </section>
        </main>

        <footer class="foot" id="contact">
            <div class="container foot__grid">
                <div>
                    <p class="mark">weragen</p>
                    <p class="foot__about">{t(site.heading)}</p>
                </div>
                <div>
                    <p class="foot__title">Продукт</p>
                    <ul>
                        <li><a href="#features">Возможности</a></li>
                        <li><a href="#load">Нагрузка и квоты</a></li>
                        <li><a href="#perimeter">Контур организации</a></li>
                        <li><a href="#control">Управление и контроль</a></li>
                    </ul>
                </div>
                <div>
                    <p class="foot__title">Проект</p>
                    <ul>
                        <li><a href={site.repository}>Исходный код</a></li>
                        <li><a href="#open">Открытый код</a></li>
                    </ul>
                </div>
                <div>
                    <p class="foot__title">Связь</p>
                    <p class="foot__note">{t(site.contactNote)}</p>
                </div>
            </div>
            <div class="container foot__bottom">weragen, 2026</div>
        </footer>
    </div>
</Base>

<style>
    .page {
        --container: 1200px;
        --radius: 16px;
        --button-radius: 999px;
    }

    .mark {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.03em;
        text-decoration: none;
    }

    h2 {
        font-size: clamp(30px, 3.8vw, 50px);
        line-height: 1.08;
        letter-spacing: -0.03em;
    }

    .lead {
        max-width: 60ch;
        padding-top: 20px;
        font-size: 20px;
        line-height: 1.5;
        color: var(--muted);
    }

    .head {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
    }

    .head__inner {
        display: flex;
        align-items: center;
        gap: 44px;
        height: 68px;
    }

    .head__nav {
        display: flex;
        gap: 28px;
        font-size: 16px;
    }

    .head__nav a {
        text-decoration: none;
        color: var(--muted);
    }

    .head__nav a:hover {
        color: var(--fg);
    }

    .head__button {
        min-height: 40px;
        margin-left: auto;
        padding: 0 20px;
        font-size: 15px;
    }

    .hero {
        padding-top: 104px;
    }

    h1 {
        font-size: min(76px, var(--title-fit));
        line-height: 1.02;
        letter-spacing: -0.038em;
    }

    .keep {
        white-space: nowrap;
    }

    .hero__lead {
        max-width: 56ch;
        padding: 28px 0 36px;
        font-size: 21px;
        line-height: 1.5;
        color: var(--muted);
    }

    .highlights {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-top: 88px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .highlights li {
        display: grid;
        align-content: start;
        gap: 6px;
        padding: 28px 24px 30px 0;
    }

    .highlights li + li {
        padding-left: 24px;
        border-left: 1px solid var(--line);
    }

    .highlights strong {
        font-size: 18px;
        font-weight: 700;
        line-height: 1.3;
    }

    .highlights span {
        font-size: 16px;
        color: var(--muted);
    }

    .section {
        padding-top: 128px;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 52px 56px;
        padding-top: 56px;
    }

    .features h3 {
        font-size: 22px;
        line-height: 1.25;
        letter-spacing: -0.012em;
    }

    .features p {
        padding-top: 10px;
        font-size: 17px;
        color: var(--muted);
    }

    .panel {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 64px;
        padding: 72px 64px;
        background: var(--surface);
        border-radius: 24px;
    }

    /* Заголовок стоит в половине ширины, поэтому он меньше остальных и ложится в две строки. */
    .panel h2 {
        font-size: clamp(28px, 3.1vw, 42px);
    }

    .panel p {
        font-size: 20px;
        line-height: 1.5;
    }

    .panel ul {
        display: grid;
        gap: 12px;
        padding-top: 32px;
        font-size: 18px;
        font-weight: 500;
    }

    .figure {
        padding-top: 64px;
    }

    /* Перевёрнутый раздел: вложенные блоки берут цвета из тех же переменных и подстраиваются сами. */
    .invert {
        --bg: var(--invert-bg);
        --fg: var(--invert-fg);
        --muted: var(--invert-muted);
        --line: var(--invert-line);
        margin-top: 128px;
        padding: 120px 0;
        background: var(--bg);
        color: var(--fg);
    }

    .invert__grid {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        align-items: start;
        gap: 80px;
    }

    .answers > div {
        padding: 26px 0;
        border-top: 1px solid var(--line);
    }

    .answers > div:first-child {
        padding-top: 0;
        border-top: 0;
    }

    .answers dt {
        font-size: 21px;
        font-weight: 700;
        line-height: 1.3;
    }

    .answers dd {
        padding-top: 6px;
        font-size: 17px;
        color: var(--muted);
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        padding-top: 56px;
    }

    .cards li {
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }

    .cards h3 {
        font-size: 19px;
        line-height: 1.3;
    }

    .cards p {
        padding-top: 10px;
        font-size: 16px;
        color: var(--muted);
    }

    .closing {
        display: grid;
        justify-items: center;
        text-align: center;
    }

    .closing .actions {
        justify-content: center;
        padding-top: 36px;
    }

    .foot {
        margin-top: 128px;
        border-top: 1px solid var(--line);
    }

    .foot__grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
        gap: 40px;
        padding: 56px 0 48px;
        font-size: 16px;
    }

    .foot__about {
        max-width: 24ch;
        padding-top: 10px;
        color: var(--muted);
    }

    .foot__title {
        padding-bottom: 12px;
        font-weight: 700;
    }

    .foot__grid li {
        padding: 4px 0;
    }

    .foot__grid a:not(.mark) {
        text-decoration: none;
        color: var(--muted);
    }

    .foot__grid a:not(.mark):hover {
        color: var(--fg);
    }

    .foot__note {
        color: var(--muted);
    }

    .foot__bottom {
        padding: 20px 0 8px;
        border-top: 1px solid var(--line);
        font-size: 15px;
        color: var(--muted);
    }

    @media (max-width: 1000px) {
        .features {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .panel,
        .invert__grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 40px;
        }

        .panel {
            padding: 56px 40px;
        }

        .cards,
        .highlights,
        .foot__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .highlights li:nth-child(3) {
            padding-left: 0;
            border-left: 0;
        }

        .highlights li:nth-child(n + 3) {
            border-top: 1px solid var(--line);
        }
    }

    @media (max-width: 760px) {
        .head__nav {
            display: none;
        }

        .hero {
            padding-top: 56px;
        }

        /* На узком экране заголовок ложится в три строки, зато набран крупнее. */
        h1 {
            font-size: calc((100vw - 2 * var(--gutter)) / 9.8);
        }

        .keep {
            white-space: normal;
        }

        .hero__lead {
            font-size: 19px;
        }

        .highlights {
            margin-top: 56px;
        }

        .section {
            padding-top: 88px;
        }

        .features,
        .cards {
            grid-template-columns: minmax(0, 1fr);
            padding-top: 40px;
        }

        .panel {
            padding: 40px 24px;
            border-radius: 20px;
        }

        .invert {
            margin-top: 88px;
            padding: 80px 0;
        }

        .foot {
            margin-top: 88px;
        }
    }

    @media (max-width: 560px) {
        .features,
        .cards,
        .highlights,
        .foot__grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .highlights li,
        .highlights li + li {
            padding: 20px 0;
            border-left: 0;
        }

        .highlights li + li {
            border-top: 1px solid var(--line);
        }
    }
</style>
