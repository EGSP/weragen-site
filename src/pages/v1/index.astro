---
/**
 * Версия 1, «Лист».
 *
 * Страница устроена как лист технического описания: слева номер и название раздела,
 * справа содержание. Изображений почти нет, смысл несут текст и тонкие линии. За образец
 * сдержанности взят сайт OpenTUI, но страница шире и рассказывает подробнее.
 */
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import HubDiagram from '../../components/HubDiagram.astro';
import JournalMock from '../../components/JournalMock.astro';
import AliasMock from '../../components/AliasMock.astro';
import CodeSample from '../../components/CodeSample.astro';
import { withBase } from '../../lib/url';
import { typograph as t } from '../../lib/typograph';
import {
    site,
    hero,
    facts,
    problem,
    features,
    feature,
    sample,
    security,
    example,
    nonGoals,
    status,
    openSource,
    cta,
} from '../../data/content';

const navigation = [
    { id: 'features', label: 'Возможности' },
    { id: 'structure', label: 'Устройство' },
    { id: 'security', label: 'Безопасность' },
    { id: 'scope', label: 'Границы' },
    { id: 'status', label: 'Состояние' },
];

const number = (index: number): string => String(index + 1).padStart(2, '0');
---

<Base title={site.title} description={site.description} version={1}>
    <div class="page">
        <header class="head">
            <div class="container head__inner mono">
                <a class="head__mark" href={withBase('/v1/')}>weragen</a>
                <nav class="head__nav" aria-label="Разделы страницы">
                    {navigation.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
                </nav>
                <a class="head__repo" href={site.repository}>GitHub</a>
            </div>
        </header>

        <main>
            <section class="hero container">
                <p class="hero__status mono">{hero.status}</p>
                <h1 class="hero__title">{t(hero.heading)}</h1>
                <div class="hero__grid">
                    <div>
                        <p class="hero__lead">{t(hero.lead)}</p>
                        <div class="actions">
                            <a class="button button--solid" href={site.repository}>{hero.primary}</a>
                            <a class="button button--outline" href="#open">{hero.secondary}</a>
                        </div>
                    </div>
                    <ul class="hero__facts">
                        {
                            facts.map((fact, index) => (
                                <li>
                                    <span class="mono">{number(index)}</span>
                                    {t(fact)}
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </section>

            <section class="row container" id="why">
                <p class="row__label mono"><span>01</span>Зачем</p>
                <div class="row__body">
                    <h2>{t(problem.title)}</h2>
                    <p class="lead">{t(problem.intro)}</p>
                    <ul class="pairs">
                        {
                            problem.items.map((item) => (
                                <li>
                                    <h3>{t(item.title)}</h3>
                                    <p>{t(item.text)}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </section>

            <section class="row container" id="features">
                <p class="row__label mono"><span>02</span>Возможности</p>
                <div class="row__body">
                    <h2>{t('Что платформа делает за программу')}</h2>
                    <ul class="pairs">
                        {
                            features.map((item, index) => (
                                <li>
                                    <p class="pairs__index mono">2.{index + 1}</p>
                                    <h3>{t(item.title)}</h3>
                                    <p>{t(item.text)}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </section>

            <section class="row container" id="structure">
                <p class="row__label mono"><span>03</span>Устройство</p>
                <div class="row__body">
                    <h2>{t('Один центр для моделей, агентов, инструментов и воркфлоу')}</h2>
                    <p class="lead">
                        {
                            t(
                                'Программы организации обращаются к weragen по API. Платформа сама ' +
                                    'работает с провайдерами и с локальными моделями. За пределы ' +
                                    'контура уходят только запросы к тем провайдерам, которых ' +
                                    'организация подключила.',
                            )
                        }
                    </p>
                    <div class="figure">
                        <HubDiagram />
                    </div>
                </div>
            </section>

            <section class="row container" id="program">
                <p class="row__label mono"><span>04</span>Для программы</p>
                <div class="row__body">
                    <h2>{t(sample.title)}</h2>
                    <p class="lead">{t(sample.text)}</p>
                    <div class="split">
                        <Frame title="Обращение к модели" note="пример">
                            <CodeSample />
                        </Frame>
                        <Frame title="Псевдонимы моделей">
                            <AliasMock />
                        </Frame>
                    </div>
                </div>
            </section>

            <section class="row container" id="journal">
                <p class="row__label mono"><span>05</span>Журнал</p>
                <div class="row__body">
                    <h2>{t(feature('journal').title)}</h2>
                    <div class="split split--text">
                        <p class="split__text">{t(feature('journal').text)}</p>
                        <Frame title="Журнал исполнения">
                            <JournalMock />
                        </Frame>
                    </div>
                </div>
            </section>

            <section class="row container" id="example">
                <p class="row__label mono"><span>06</span>Пример</p>
                <div class="row__body">
                    <h2>{t(example.title)}</h2>
                    <p class="lead">{t(example.intro)}</p>
                    <ol class="steps">
                        {
                            example.steps.map((step, index) => (
                                <li>
                                    <p class="steps__index mono">{number(index)}</p>
                                    <h3>{t(step.title)}</h3>
                                    <p>{t(step.text)}</p>
                                </li>
                            ))
                        }
                    </ol>
                </div>
            </section>

            <section class="row container" id="security">
                <p class="row__label mono"><span>07</span>Безопасность</p>
                <div class="row__body">
                    <h2>{t(security.title)}</h2>
                    <p class="lead">{t(security.intro)}</p>
                    <dl class="pairs">
                        {
                            security.items.map((item) => (
                                <div>
                                    <dt>{t(item.question)}</dt>
                                    <dd>{t(item.answer)}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>
            </section>

            <section class="row container" id="scope">
                <p class="row__label mono"><span>08</span>Границы</p>
                <div class="row__body">
                    <h2>{t(nonGoals.title)}</h2>
                    <p class="lead">{t(nonGoals.intro)}</p>
                    <ul class="pairs">
                        {
                            nonGoals.items.map((item) => (
                                <li>
                                    <h3>{t(item.title)}</h3>
                                    <p>{t(item.text)}</p>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </section>

            <section class="row container" id="status">
                <p class="row__label mono"><span>09</span>Состояние</p>
                <div class="row__body">
                    <h2>{t(status.title)}</h2>
                    <p class="lead">{t(status.intro)}</p>
                    <div class="pairs">
                        {
                            [status.first, status.later].map((group) => (
                                <div>
                                    <h3>{group.title}</h3>
                                    <ul class="lines">
                                        {group.items.map((item) => <li>{t(item)}</li>)}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="row container" id="open">
                <p class="row__label mono"><span>10</span>Открытый код</p>
                <div class="row__body">
                    <h2>{t(openSource.title)}</h2>
                    {openSource.paragraphs.map((paragraph) => <p class="lead">{t(paragraph)}</p>)}
                    <div class="actions closing">
                        <a class="button button--solid" href={site.repository}>{hero.primary}</a>
                    </div>
                    <p class="note mono">{t(cta.contactNote)}</p>
                </div>
            </section>
        </main>

        <footer class="foot">
            <div class="container foot__inner mono">
                <span>weragen, 2026</span>
                <a href={site.repository}>github.com/EGSP/weragen</a>
            </div>
        </footer>
    </div>
</Base>

<style>
    .page {
        --container: 1160px;
    }

    .head {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
    }

    .head__inner {
        display: flex;
        align-items: center;
        gap: 28px;
        height: 56px;
        font-size: 13px;
    }

    .head__mark {
        font-size: 15px;
        font-weight: 500;
        text-decoration: none;
    }

    .head__nav {
        display: flex;
        gap: 24px;
        margin-left: auto;
    }

    .head__nav a {
        color: var(--muted);
        text-decoration: none;
    }

    .head__nav a:hover {
        color: var(--fg);
    }

    .hero {
        padding: 88px 0 96px;
    }

    .hero__status {
        padding-bottom: 28px;
        font-size: 13px;
        color: var(--muted);
    }

    .hero__title {
        max-width: 22ch;
        font-size: min(72px, var(--title-fit));
        font-weight: 500;
        line-height: 1.04;
        letter-spacing: -0.025em;
    }

    .hero__grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        align-items: start;
        gap: 72px;
        padding-top: 52px;
    }

    .hero__lead {
        padding-bottom: 32px;
        font-size: 19px;
        line-height: 1.6;
    }

    .hero__facts li {
        display: grid;
        grid-template-columns: 40px minmax(0, 1fr);
        padding: 11px 0;
        border-top: 1px solid var(--line);
        font-size: 15px;
        line-height: 1.5;
    }

    .hero__facts li:last-child {
        border-bottom: 1px solid var(--line);
    }

    .hero__facts span {
        padding-top: 3px;
        font-size: 12px;
        color: var(--muted);
    }

    .row {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 40px;
        padding: 72px 0 80px;
        border-top: 1px solid var(--fg);
    }

    .row__label {
        position: sticky;
        top: 80px;
        align-self: start;
        font-size: 13px;
    }

    .row__label span {
        padding-right: 12px;
        color: var(--muted);
    }

    .row__body h2 {
        max-width: 22ch;
        font-size: clamp(26px, 3.2vw, 38px);
        font-weight: 500;
        line-height: 1.14;
        letter-spacing: -0.018em;
    }

    .lead {
        max-width: 64ch;
        padding-top: 18px;
        font-size: 18px;
        line-height: 1.6;
    }

    .pairs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 40px 56px;
        padding-top: 44px;
    }

    .pairs h3,
    .pairs dt {
        padding-bottom: 8px;
        font-size: 17px;
        font-weight: 600;
        line-height: 1.35;
    }

    .pairs p,
    .pairs dd {
        font-size: 15.5px;
        line-height: 1.62;
        color: var(--muted);
    }

    .pairs .pairs__index {
        padding-bottom: 10px;
        font-size: 12px;
    }

    .figure {
        padding-top: 48px;
    }

    .split {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        align-items: start;
        gap: 24px;
        padding-top: 40px;
    }

    .split--text {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
        gap: 48px;
        padding-top: 28px;
    }

    .split__text {
        font-size: 17px;
        line-height: 1.62;
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 28px;
        padding-top: 44px;
    }

    .steps li {
        padding-top: 14px;
        border-top: 1px solid var(--fg);
    }

    .steps__index {
        padding-bottom: 14px;
        font-size: 12px;
        color: var(--muted);
    }

    .steps h3 {
        padding-bottom: 8px;
        font-size: 16px;
        line-height: 1.35;
    }

    .steps li > p:last-child {
        font-size: 14.5px;
        line-height: 1.6;
        color: var(--muted);
    }

    .lines li {
        padding: 10px 0;
        border-top: 1px solid var(--line);
        font-size: 15.5px;
        color: var(--fg);
    }

    .lines li:last-child {
        border-bottom: 1px solid var(--line);
    }

    .closing {
        padding-top: 32px;
    }

    .note {
        padding-top: 16px;
        font-size: 12px;
        color: var(--muted);
    }

    .foot {
        border-top: 1px solid var(--fg);
    }

    .foot__inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        padding: 24px 0;
        font-size: 13px;
        color: var(--muted);
    }

    @media (max-width: 960px) {
        .head__nav {
            display: none;
        }

        .head__repo {
            margin-left: auto;
        }

        .hero {
            padding: 56px 0 64px;
        }

        .hero__grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 44px;
            padding-top: 32px;
        }

        .row {
            grid-template-columns: minmax(0, 1fr);
            gap: 20px;
            padding: 48px 0 56px;
        }

        .row__label {
            position: static;
        }

        .split,
        .split--text {
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
        }

        .steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .pairs,
        .steps {
            grid-template-columns: minmax(0, 1fr);
            gap: 28px;
        }

        .hero__lead,
        .lead {
            font-size: 17px;
        }
    }
</style>
