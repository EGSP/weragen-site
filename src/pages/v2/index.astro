---
/**
 * Вариант 2, "Плакат".
 *
 * Страница набрана как плакат: каждое утверждение стоит отдельно и занимает почти весь
 * экран по ширине, пояснение к нему умещается в одну строку рядом. Карточек, схем и линий
 * нет, ритм создают только размер шрифта и пустое место.
 */
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { typograph as t } from '../../lib/typograph';
import { site, poster, nonGoals } from '../../data/content';
---

<Base title={site.title} description={site.description} version={2}>
    <div class="page">
        <header class="top container">
            <a class="mark" href={withBase('/v2/')}>weragen</a>
            <a class="top__link" href={site.repository}>GitHub</a>
        </header>

        <main>
            <section class="hero container">
                <h1>{site.headingStart} <span class="keep">{site.headingEnd}</span></h1>
                <p class="hero__lead">{t(poster.lead)}</p>
                <div class="actions">
                    <a class="button button--solid" href={site.repository}>{site.primary}</a>
                    <a class="button button--outline" href="#contact">{site.secondary}</a>
                </div>
            </section>

            <section class="container" id="claims">
                {
                    poster.claims.map((claim) => (
                        <article class="claim">
                            <h2>{t(claim.title)}</h2>
                            <p>{t(claim.text)}</p>
                        </article>
                    ))
                }
            </section>

            <section class="band" id="perimeter">
                <div class="container claim">
                    <h2>{t(poster.perimeter.title)}</h2>
                    <p>{t(poster.perimeter.text)}</p>
                </div>
            </section>

            <section class="container scope" id="scope">
                <h2>{t(poster.scopeTitle)}</h2>
                <ul>
                    {nonGoals.map((item) => <li>{item.title}</li>)}
                </ul>
            </section>

            <section class="container final" id="open">
                <h2>{t(poster.open.title)}</h2>
                <p>{t(poster.open.text)}</p>
                <div class="actions">
                    <a class="button button--solid" href={site.repository}>{site.primary}</a>
                    <a class="button button--outline" href="#contact">{site.secondary}</a>
                </div>
            </section>
        </main>

        <footer class="container foot" id="contact">
            <span class="mark">weragen</span>
            <span class="foot__note">{t(site.contactNote)}</span>
            <a href={site.repository}>GitHub</a>
        </footer>
    </div>
</Base>

<style>
    .page {
        --container: 1360px;
        /* Расстояние между утверждениями. Оно и задаёт ритм страницы. */
        --gap: clamp(88px, 12vw, 184px);
    }

    .mark {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.03em;
        text-decoration: none;
    }

    .top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding-top: 32px;
        font-size: 18px;
    }

    .hero {
        padding-top: clamp(72px, 11vw, 168px);
    }

    h1 {
        font-size: min(122px, var(--title-fit));
        line-height: 0.98;
        letter-spacing: -0.048em;
    }

    .keep {
        white-space: nowrap;
    }

    .hero__lead {
        max-width: 34ch;
        padding: clamp(28px, 3.4vw, 52px) 0 clamp(28px, 3vw, 44px);
        font-size: clamp(20px, 2vw, 30px);
        line-height: 1.35;
        color: var(--muted);
    }

    .button {
        min-height: 58px;
        padding: 0 32px;
        font-size: 18px;
    }

    /* Утверждение слева, пояснение справа у нижнего края: так занята вся ширина страницы. */
    .claim {
        display: grid;
        grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
        align-items: end;
        gap: 56px;
        padding-top: var(--gap);
    }

    h2 {
        font-size: clamp(30px, 6.3vw, 96px);
        line-height: 1;
        letter-spacing: -0.042em;
    }

    .claim p,
    .final p {
        padding-bottom: 0.3em;
        font-size: clamp(18px, 1.55vw, 24px);
        line-height: 1.4;
        color: var(--muted);
    }

    .band {
        --bg: var(--invert-bg);
        --fg: var(--invert-fg);
        --muted: var(--invert-muted);
        margin-top: var(--gap);
        padding-bottom: var(--gap);
        background: var(--bg);
        color: var(--fg);
    }

    .scope {
        padding-top: var(--gap);
    }

    .scope ul {
        padding-top: clamp(32px, 4vw, 64px);
        font-size: clamp(26px, 4.3vw, 64px);
        font-weight: 700;
        line-height: 1.16;
        letter-spacing: -0.035em;
        color: var(--muted);
    }

    .final {
        padding-top: var(--gap);
    }

    .final h2 {
        font-size: min(122px, var(--title-fit));
        line-height: 0.98;
        letter-spacing: -0.048em;
    }

    .final p {
        max-width: 40ch;
        padding: clamp(24px, 3vw, 44px) 0 clamp(28px, 3vw, 44px);
    }

    .foot {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px 32px;
        padding-top: var(--gap);
        font-size: 18px;
    }

    .foot__note {
        margin-right: auto;
        color: var(--muted);
    }

    @media (max-width: 900px) {
        .claim {
            grid-template-columns: minmax(0, 1fr);
            gap: 16px;
        }

        .claim p {
            max-width: 36ch;
            padding-bottom: 0;
        }
    }

    /* На узком экране заголовок ложится в три строки, зато остаётся крупнее утверждений. */
    @media (max-width: 700px) {
        h1 {
            font-size: calc((100vw - 2 * var(--gutter)) / 9.8);
            line-height: 1.02;
        }

        .keep {
            white-space: normal;
        }
    }

    @media (max-width: 560px) {
        .button {
            min-height: 52px;
            padding: 0 24px;
            font-size: 17px;
        }

        .foot__note {
            flex-basis: 100%;
            order: 3;
        }
    }
</style>
