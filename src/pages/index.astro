---
/**
 * Обзорная страница: перечень вариантов лендинга с кратким описанием каждого.
 * Она нужна на время сравнения. После выбора варианта её место займёт сам лендинг.
 */
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { typograph as t } from '../lib/typograph';
import { site } from '../data/content';

const versions = [
    {
        number: 1,
        name: 'Сборная',
        text: 'Страница продукта из блоков, которые понравились в первом наборе. Со схемой контура.',
    },
    {
        number: 2,
        name: 'Плакат',
        text: 'Крупная типографика. Каждое утверждение стоит отдельно, схем и карточек нет.',
    },
    {
        number: 3,
        name: 'Конспект',
        text: 'Только текст. Слева заголовок и кнопки, справа короткие ответы на вопросы читателя.',
    },
];
---

<Base title="weragen. Варианты лендинга" description={site.description}>
    <main class="overview container">
        <h1>Три варианта лендинга</h1>
        <ul>
            {
                versions.map((version) => (
                    <li>
                        <a href={withBase(`/v${version.number}/`)}>
                            <strong>{version.name}</strong>
                            <span>{t(version.text)}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </main>
</Base>

<style>
    .overview {
        --container: 920px;
        padding-top: 112px;
    }

    h1 {
        font-size: clamp(36px, 5.4vw, 64px);
        line-height: 1.04;
        letter-spacing: -0.035em;
    }

    ul {
        display: grid;
        gap: 12px;
        padding-top: 56px;
    }

    a {
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 8px 32px;
        align-items: baseline;
        padding: 28px 32px;
        background: var(--surface);
        border-radius: 16px;
        text-decoration: none;
    }

    a:hover {
        background: var(--fg);
        color: var(--bg);
    }

    strong {
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    span {
        font-size: 18px;
        line-height: 1.45;
    }

    @media (max-width: 640px) {
        .overview {
            padding-top: 64px;
        }

        a {
            grid-template-columns: minmax(0, 1fr);
            padding: 24px;
        }
    }
</style>
