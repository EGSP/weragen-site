---
/**
 * Лендинг weragen.
 *
 * Страница начинается с того, что даёт платформа, и до самого конца не говорит о помощи
 * и внедрении: этому отведён последний раздел. Он единственный на странице цветной.
 * Мелких подписей, нумерации и схем интерфейса здесь нет, из изображений только схема
 * контура организации. Кнопок тоже нет: всё, что уводит со страницы, оформлено ссылкой
 * со значком перехода.
 */
import Base from '../layouts/Base.astro';
import HubDiagram from '../components/HubDiagram.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { withBase } from '../lib/url';
import { typograph as t } from '../lib/typograph';
import { site, lead, highlights, features, load, perimeter, control, scope, open, help } from '../data/content';
---

<Base title={site.title} description={site.description}>
    <div class="page">
        <header class="head">
            <div class="container head__inner">
                <a class="mark" href={withBase('/')}>weragen</a>
                <nav class="head__links" aria-label="Ссылки">
                    <a href="#help">Помощь</a>
                    <ExternalLink href={site.repository} underline={false}>GitHub</ExternalLink>
                </nav>
            </div>
        </header>

        <main>
            <section class="hero container">
                <h1>{site.headingStart} <span class="keep">{site.headingEnd}</span></h1>
                <p class="hero__lead">{t(lead)}</p>
                <p class="hero__link">
                    <ExternalLink href={site.repository}>{site.sourceLink}</ExternalLink>
                </p>
                <ul class="highlights">
                    {
                        highlights.map((item) => (
                            <li>
                                <strong>{t(item.title)}</strong>
                                <span>{t(item.text)}</span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container" id="features">
                <h2>{t(features.title)}</h2>
                <ul class="cards cards--filled">
                    {
                        features.items.map((item) => (
                            <li>
                                <h3>{t(item.title)}</h3>
                                <p>{t(item.text)}</p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container" id="load">
                <div class="panel light">
                    <h2>{t(load.title)}</h2>
                    <div>
                        <p>{t(load.text)}</p>
                        <ul>
                            {load.points.map((point) => <li>{t(point)}</li>)}
                        </ul>
                    </div>
                </div>
            </section>

            <section class="section container" id="perimeter">
                <h2>{t(perimeter.title)}</h2>
                <p class="lead">{t(perimeter.text)}</p>
                <div class="figure">
                    <HubDiagram />
                </div>
            </section>

            <section class="band light" id="control">
                <div class="container band__grid">
                    <div>
                        <h2>{t(control.title)}</h2>
                        <p class="lead">{t(control.text)}</p>
                    </div>
                    <dl class="answers">
                        {
                            control.items.map((item) => (
                                <div>
                                    <dt>{t(item.title)}</dt>
                                    <dd>{t(item.text)}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>
            </section>

            <section class="section container" id="scope">
                <h2>{t(scope.title)}</h2>
                <ul class="cards">
                    {
                        scope.items.map((item) => (
                            <li>
                                <h3>{item.title}</h3>
                                <p>{t(item.text)}</p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="section container closing" id="open">
                <h2>{t(open.title)}</h2>
                <p class="lead">{t(open.text)}</p>
                <p class="closing__link">
                    <ExternalLink href={site.repository}>{site.sourceLink}</ExternalLink>
                </p>
            </section>

            <section class="help" id="help">
                <div class="container">
                    <h2>{help.title}</h2>
                    <div class="help__grid">
                        <div class="help__card" id="community">
                            <h3>{help.community.title}</h3>
                            <p>{t(help.community.text)}</p>
                            <p class="help__action">
                                <ExternalLink href={site.issues}>{help.community.link}</ExternalLink>
                            </p>
                        </div>
                        <div class="help__card" id="turnkey">
                            <h3>{help.turnkey.title}</h3>
                            <p>{t(help.turnkey.text)}</p>
                            <p class="help__action">{t(help.turnkey.contactNote)}</p>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <footer class="foot">
            <div class="container foot__grid">
                <div>
                    <p class="mark">weragen</p>
                    <p class="foot__about">{t(site.heading)}</p>
                </div>
                <div>
                    <p class="foot__title">Продукт</p>
                    <ul>
                        <li><a href="#features">Возможности</a></li>
                        <li><a href="#load">Нагрузка и квоты</a></li>
                        <li><a href="#perimeter">Контур организации</a></li>
                        <li><a href="#control">Управление и контроль</a></li>
                    </ul>
                </div>
                <div>
                    <p class="foot__title">Проект</p>
                    <ul>
                        <li><ExternalLink href={site.repository} underline={false}>{site.sourceLink}</ExternalLink></li>
                        <li><a href="#open">Открытый код</a></li>
                    </ul>
                </div>
                <div>
                    <p class="foot__title">Помощь</p>
                    <ul>
                        <li><a href="#community">Сообщество</a></li>
                        <li><a href="#turnkey">Внедрение под ключ</a></li>
                    </ul>
                </div>
            </div>
            <div class="container foot__bottom">weragen, 2026</div>
        </footer>
    </div>
</Base>

<style>
    .page {
        --container: 1200px;
        --radius: 16px;
    }

    .mark {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.03em;
        text-decoration: none;
    }

    h2 {
        font-size: clamp(30px, 3.8vw, 50px);
        line-height: 1.08;
        letter-spacing: -0.03em;
    }

    .lead {
        max-width: 60ch;
        padding-top: 20px;
        font-size: 20px;
        line-height: 1.5;
        color: var(--muted);
    }

    /* Светлый блок на тёмной странице. Вложенные элементы берут цвета из тех же переменных. */
    .light {
        --bg: var(--light-bg);
        --fg: var(--light-fg);
        --muted: var(--light-muted);
        --line: var(--light-line);
        background: var(--bg);
        color: var(--fg);
    }

    .head {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
    }

    .head__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 68px;
    }

    .head__links {
        display: flex;
        align-items: center;
        gap: 32px;
        font-size: 17px;
        font-weight: 500;
    }

    .head__links > a {
        text-decoration: none;
    }

    .head__links > a:hover {
        text-decoration: underline;
        text-decoration-thickness: 2px;
    }

    .hero {
        padding-top: 104px;
    }

    h1 {
        font-size: min(76px, var(--title-fit));
        line-height: 1.02;
        letter-spacing: -0.038em;
    }

    .keep {
        white-space: nowrap;
    }

    .hero__lead {
        max-width: 56ch;
        padding: 28px 0 32px;
        font-size: 22px;
        line-height: 1.45;
        color: var(--muted);
    }

    .hero__link {
        font-size: 21px;
        font-weight: 500;
    }

    .highlights {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-top: 88px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .highlights li {
        display: grid;
        align-content: start;
        gap: 6px;
        padding: 28px 24px 30px 0;
    }

    .highlights li + li {
        padding-left: 24px;
        border-left: 1px solid var(--line);
    }

    .highlights strong {
        font-size: 18px;
        font-weight: 700;
        line-height: 1.3;
    }

    .highlights span {
        font-size: 16px;
        color: var(--muted);
    }

    .section {
        padding-top: 128px;
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        padding-top: 56px;
    }

    .cards li {
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }

    /* Карточки возможностей залиты, карточки "чем не является" оставлены с одной границей. */
    .cards--filled li {
        background: var(--surface);
    }

    .cards h3 {
        font-size: 20px;
        line-height: 1.3;
    }

    .cards p {
        padding-top: 10px;
        font-size: 16.5px;
        color: var(--muted);
    }

    .panel {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 64px;
        padding: 72px 64px;
        border-radius: 24px;
    }

    /* Заголовок стоит в половине ширины, поэтому он меньше остальных и ложится в две строки. */
    .panel h2 {
        font-size: clamp(28px, 3.1vw, 42px);
    }

    .panel p {
        font-size: 20px;
        line-height: 1.5;
    }

    .panel ul {
        display: grid;
        gap: 12px;
        padding-top: 32px;
        font-size: 18px;
        font-weight: 500;
    }

    .figure {
        padding-top: 64px;
    }

    .band {
        margin-top: 128px;
        padding: 120px 0;
    }

    .band__grid {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        align-items: start;
        gap: 80px;
    }

    .answers > div {
        padding: 26px 0;
        border-top: 1px solid var(--line);
    }

    .answers > div:first-child {
        padding-top: 0;
        border-top: 0;
    }

    .answers dt {
        font-size: 21px;
        font-weight: 700;
        line-height: 1.3;
    }

    .answers dd {
        padding-top: 6px;
        font-size: 17px;
        color: var(--muted);
    }

    .closing {
        display: grid;
        justify-items: center;
        text-align: center;
    }

    .closing__link {
        padding-top: 28px;
        font-size: 21px;
        font-weight: 500;
    }

    /* Раздел о помощи. Единственный цветной блок на странице. */
    .help {
        --bg: #ffd84a;
        --fg: #0c0c0c;
        --muted: #4a4220;
        margin-top: 128px;
        padding: 112px 0 120px;
        background: var(--bg);
        color: var(--fg);
    }

    .help__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        padding-top: 56px;
    }

    .help__card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 40px;
        background: rgb(255 255 255 / 0.55);
        border-radius: 24px;
    }

    .help__card h3 {
        font-size: 28px;
        line-height: 1.15;
        letter-spacing: -0.02em;
    }

    .help__card p {
        font-size: 19px;
        line-height: 1.5;
        color: var(--muted);
    }

    /* Ссылка и строка о связи прижаты к низу карточки, чтобы стоять на одной линии. */
    .help__card .help__action {
        margin-top: auto;
        padding-top: 14px;
        font-weight: 500;
        color: var(--fg);
    }

    /* Подвал идёт сразу за цветным разделом, поэтому отступа и линии сверху у него нет. */
    .foot__grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
        gap: 40px;
        padding: 64px 0 48px;
        font-size: 16px;
    }

    .foot__about {
        max-width: 24ch;
        padding-top: 10px;
        color: var(--muted);
    }

    .foot__title {
        padding-bottom: 12px;
        font-weight: 700;
    }

    .foot__grid li {
        padding: 4px 0;
        color: var(--muted);
    }

    .foot__grid li > a {
        text-decoration: none;
    }

    .foot__grid li > a:hover {
        color: var(--fg);
    }

    .foot__bottom {
        padding: 20px 0 40px;
        border-top: 1px solid var(--line);
        font-size: 15px;
        color: var(--muted);
    }

    @media (max-width: 1000px) {
        .panel,
        .band__grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 40px;
        }

        .panel {
            padding: 56px 40px;
        }

        .cards,
        .highlights,
        .foot__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .highlights li:nth-child(3) {
            padding-left: 0;
            border-left: 0;
        }

        .highlights li:nth-child(n + 3) {
            border-top: 1px solid var(--line);
        }
    }

    @media (max-width: 760px) {
        .hero {
            padding-top: 56px;
        }

        /* На узком экране заголовок ложится в три строки, зато набран крупнее. */
        h1 {
            font-size: calc((100vw - 2 * var(--gutter)) / 9.8);
        }

        .keep {
            white-space: normal;
        }

        .hero__lead {
            font-size: 20px;
        }

        .highlights {
            margin-top: 56px;
        }

        .section {
            padding-top: 88px;
        }

        .cards {
            grid-template-columns: minmax(0, 1fr);
            padding-top: 40px;
        }

        .panel {
            padding: 40px 24px;
            border-radius: 20px;
        }

        .band {
            margin-top: 88px;
            padding: 80px 0;
        }

        .help {
            margin-top: 88px;
            padding: 72px 0 80px;
        }

        .help__grid {
            grid-template-columns: minmax(0, 1fr);
            padding-top: 40px;
        }

        .help__card {
            padding: 28px 24px;
        }

        .help__card h3 {
            font-size: 24px;
        }
    }

    @media (max-width: 560px) {
        .highlights,
        .foot__grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .highlights li,
        .highlights li + li {
            padding: 20px 0;
            border-left: 0;
        }

        .highlights li + li {
            border-top: 1px solid var(--line);
        }
    }
</style>
