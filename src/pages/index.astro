---
import ArticleLanding from '../components/ArticleLanding.astro';
import DeveloperLanding from '../components/DeveloperLanding.astro';
import PlatformLanding from '../components/PlatformLanding.astro';
import '../styles/landing.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-sans/cyrillic-700.css';
import '@fontsource/golos-text/latin-400.css';
import '@fontsource/golos-text/cyrillic-400.css';
import '@fontsource/golos-text/latin-700.css';
import '@fontsource/golos-text/cyrillic-700.css';
const versions = ['Статья', 'Разработчикам', 'Платформа'];
---
<!doctype html>
<html lang="ru" data-font="ibm" data-version="3">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="weragen: открытая платформа для ИИ-автоматизаций. Модели, агенты, инструменты и процессы в одном месте, внутри вашей организации." />
    <meta name="theme-color" content="#ffffff" />
    <title>weragen · Открытая платформа для ИИ-автоматизаций</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">К содержанию</a>
    <div class="preview-bar" aria-label="Настройки просмотра">
        <div class="control-group" role="group" aria-label="Вариант сайта">
          {versions.map((name, index) => <button type="button" data-select-version={index + 1} aria-pressed={index === 2}>{name}</button>)}
        </div>
        <div class="control-group" role="group" aria-label="Шрифт">
          <button type="button" data-select-font="ibm" aria-pressed="true">IBM Plex</button>
          <button type="button" data-select-font="golos" aria-pressed="false">Golos</button>
        </div>
    </div>
    <main id="content">
      <div data-landing="1" hidden><ArticleLanding /></div>
      <div data-landing="2" hidden><DeveloperLanding /></div>
      <div data-landing="3"><PlatformLanding /></div>
    </main>
    <div class="sr-only" role="status" aria-live="polite" id="preview-status"></div>
    <noscript><p class="no-script">Для переключения вариантов нужен JavaScript. Сейчас открыт вариант Платформа.</p></noscript>
    <script>
      const versionButtons = document.querySelectorAll<HTMLButtonElement>('[data-select-version]');
      const fontButtons = document.querySelectorAll<HTMLButtonElement>('[data-select-font]');
      const landings = document.querySelectorAll<HTMLElement>('[data-landing]');
      const status = document.querySelector<HTMLElement>('#preview-status');

      /** Применяет известные варианты из адреса; скрытые лендинги исключаются из навигации с клавиатуры. */
      function applyPreview() {
        const parameters = new URL(location.href).searchParams;
        const requestedVersion = parameters.get('version');
        const version = requestedVersion && ['1', '2', '3'].includes(requestedVersion) ? requestedVersion : '3';
        const font = parameters.get('font') === 'golos' ? 'golos' : 'ibm';
        document.documentElement.dataset.version = version;
        document.documentElement.dataset.font = font;
        landings.forEach(landing => {
          const active = landing.dataset.landing === version;
          landing.hidden = !active;
          // Нативные якоря принадлежат видимой версии; без JavaScript открыт вариант Платформа.
          landing.querySelectorAll<HTMLElement>('[data-anchor]').forEach(section => {
            section.id = active ? section.dataset.anchor ?? '' : `${section.dataset.anchor}-${landing.dataset.landing}`;
          });
        });
        versionButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.selectVersion === version)));
        fontButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.selectFont === font)));
        if (status) status.textContent = `${document.querySelector<HTMLButtonElement>('[data-select-version][aria-pressed="true"]')?.textContent}. Шрифт ${font === 'ibm' ? 'IBM Plex Sans' : 'Golos Text'}.`;
      }

      /** Сохраняет выбор в адресе, чтобы ссылку на конкретное сочетание можно было открыть повторно. */
      function selectPreview(parameter: string, value: string) {
        const address = new URL(location.href);
        address.searchParams.set(parameter, value);
        // Старый якорь мог бы переместить читателя в середину новой композиции.
        if (parameter === 'version') address.hash = '';
        history.pushState(null, '', address);
        applyPreview();
        if (parameter === 'version') window.scrollTo({ top: 0, behavior: 'instant' });
      }
      versionButtons.forEach(button => button.addEventListener('click', () => selectPreview('version', button.dataset.selectVersion ?? '3')));
      fontButtons.forEach(button => button.addEventListener('click', () => selectPreview('font', button.dataset.selectFont ?? 'ibm')));
      window.addEventListener('popstate', applyPreview);
      applyPreview();
    </script>
  </body>
</html>
