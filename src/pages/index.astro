---
import Landing from '../components/Landing.astro';
import '../styles/landing.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-sans/cyrillic-700.css';
const baseAddress = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="weragen, открытая платформа для ИИ-автоматизаций в контуре организации. Общий доступ к моделям, агентам и инструментам. Логика процессов в ваших сервисах." />
    <meta name="theme-color" content="#171717" />
    <title>weragen · Открытая платформа для ИИ-автоматизаций</title>
    <link rel="icon" href={baseAddress + (baseAddress.endsWith('/') ? '' : '/') + 'favicon.svg'} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">К содержанию</a>
    <Landing />
  </body>
</html>
