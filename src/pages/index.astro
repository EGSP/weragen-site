---
/**
 * Обзорная страница: перечень версий лендинга с кратким описанием каждой.
 * Она нужна на время сравнения; после выбора версии её место займёт сам лендинг.
 */
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { typograph as t } from '../lib/typograph';
import { site } from '../data/content';

const versions = [
    {
        number: 1,
        name: 'Лист',
        text:
            'Страница как лист технического описания: номер и название раздела слева, содержание ' +
            'справа. Текста больше всего, изображений почти нет. Ближе всего к OpenTUI.',
    },
    {
        number: 2,
        name: 'Витрина',
        text:
            'Порядок разделов как на странице продукта JetBrains: крупный заголовок и вид журнала, ' +
            'возможности парами «текст и изображение», тёмный раздел для организации, призыв ' +
            'к действию и подробный подвал.',
    },
    {
        number: 3,
        name: 'Хаб',
        text:
            'В центре страницы схема платформы и сетка модулей. Дальше идут колонки для разных ' +
            'читателей, сравнение «было и стало» и путь одного запроса.',
    },
];
---

<Base title="weragen: версии лендинга" description={site.description}>
    <main class="overview container">
        <p class="overview__mark mono">weragen</p>
        <h1>{t('Три версии лендинга')}</h1>
        <p class="overview__lead">
            {
                t(
                    'Текст во всех версиях один и взят из ответов о концепции продукта. Различаются ' +
                        'устройство страницы и подача. Шрифт и тема переключаются на панели внизу.',
                )
            }
        </p>
        <ol class="overview__list">
            {
                versions.map((version) => (
                    <li>
                        <a href={withBase(`/v${version.number}/`)}>
                            <span class="mono overview__number">0{version.number}</span>
                            <span class="overview__name">{version.name}</span>
                            <span class="overview__text">{t(version.text)}</span>
                        </a>
                    </li>
                ))
            }
        </ol>
    </main>
</Base>

<style>
    .overview {
        --container: 880px;
        padding: 96px 0 64px;
    }

    .overview__mark {
        padding-bottom: 24px;
        font-size: 15px;
        font-weight: 500;
    }

    h1 {
        font-size: clamp(34px, 5vw, 56px);
        font-weight: 500;
        line-height: 1.06;
        letter-spacing: -0.02em;
    }

    .overview__lead {
        max-width: 60ch;
        padding: 20px 0 48px;
        font-size: 18px;
        color: var(--muted);
    }

    .overview__list a {
        display: grid;
        grid-template-columns: 56px 160px minmax(0, 1fr);
        gap: 8px 16px;
        padding: 24px 0;
        border-top: 1px solid var(--fg);
        text-decoration: none;
    }

    .overview__list li:last-child a {
        border-bottom: 1px solid var(--fg);
    }

    .overview__list a:hover .overview__name {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .overview__number {
        padding-top: 5px;
        font-size: 13px;
        color: var(--muted);
    }

    .overview__name {
        font-size: 22px;
        font-weight: 500;
        line-height: 1.3;
    }

    .overview__text {
        color: var(--muted);
    }

    @media (max-width: 640px) {
        .overview {
            padding-top: 56px;
        }

        .overview__list a {
            grid-template-columns: 40px minmax(0, 1fr);
        }

        .overview__text {
            grid-column: 2;
        }
    }
</style>
