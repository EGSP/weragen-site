---
/**
 * Условный граф воркфлоу: шаги разного вида в одном сценарии. Узлы стоят в ряд, а в узкой
 * рамке выстраиваются сверху вниз.
 */
const nodes = [
    { kind: 'вход', name: 'Период и схема ответа' },
    { kind: 'программа, Python', name: 'Сбор данных' },
    { kind: 'агент', name: 'Анализ графиков' },
    { kind: 'модель', name: 'Заключение' },
    { kind: 'выход', name: 'JSON по схеме' },
];
---

<div class="graph mono">
    <ol>
        {
            nodes.map((node) => (
                <li>
                    <span class="graph__kind">{node.kind}</span>
                    <span class="graph__name">{node.name}</span>
                </li>
            ))
        }
    </ol>
</div>

<style>
    .graph {
        container-type: inline-size;
        font-size: 13px;
        line-height: 18px;
    }

    ol {
        --gap: 18px;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: var(--gap);
    }

    li {
        position: relative;
        display: grid;
        align-content: start;
        gap: 4px;
        padding: 10px;
        border: 1px solid var(--fg);
    }

    /* Связь с предыдущим узлом. */
    li + li::before {
        content: '';
        position: absolute;
        top: 50%;
        left: calc(-1 * var(--gap) - 1px);
        width: var(--gap);
        border-top: 1px solid var(--fg);
    }

    .graph__kind {
        color: var(--muted);
        font-size: 11px;
    }

    @container (max-width: 620px) {
        ol {
            grid-template-columns: minmax(0, 1fr);
        }

        li {
            grid-template-columns: 150px minmax(0, 1fr);
            align-items: baseline;
        }

        li + li::before {
            top: calc(-1 * var(--gap) - 1px);
            left: 24px;
            width: 0;
            height: var(--gap);
            border-top: 0;
            border-left: 1px solid var(--fg);
        }
    }

    @container (max-width: 380px) {
        li {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
