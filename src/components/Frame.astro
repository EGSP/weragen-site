---
/**
 * Рамка для условного изображения интерфейса.
 *
 * Изображения на странице нарисованы разметкой и показывают замысел, а не снимок готовой
 * платформы, поэтому в заголовке рамки всегда стоит пометка «схема».
 */
interface Props {
    title: string;
    note?: string;
}

const { title, note = 'схема интерфейса' } = Astro.props;
---

<figure class="frame">
    <figcaption class="frame__bar mono">
        <span>{title}</span>
        <span class="frame__note">{note}</span>
    </figcaption>
    <div class="frame__body">
        <slot />
    </div>
</figure>

<style>
    .frame {
        border: 1px solid var(--fg);
        border-radius: var(--frame-radius, var(--radius));
        background: var(--bg);
        color: var(--fg);
        overflow: hidden;
        min-width: 0;
    }

    .frame__bar {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
        line-height: 1.4;
    }

    .frame__note {
        color: var(--muted);
        white-space: nowrap;
    }

    .frame__body {
        padding: 16px;
    }
</style>
